+_orig_linear = torch.nn.functional.linear
+
+_xpu_linear_chunk = {}
+
+def _xpu_chunked_linear(input, weight, bias=None):
+    # oneDNN on Arc Pro B60 rejects many GEMM shapes, including short prompts.
+    # The row slice is exact. A shape that fails every GPU size falls back to CPU.
+    if (type(input) is not torch.Tensor or getattr(input, "device", None) is None
+            or input.device.type != "xpu" or weight is None or weight.dim() != 2):
+        return _orig_linear(input, weight, bias)
+    if type(weight) is not torch.Tensor:
+        try:
+            return _orig_linear(input, weight, bias)
+        except RuntimeError:
+            if hasattr(weight, "dequantize"):
+                weight = weight.dequantize()
+            return _xpu_chunked_linear(input, weight, bias)
+    if weight.dtype != input.dtype:
+        weight = weight.to(dtype=input.dtype)
+    if bias is not None and torch.is_tensor(bias) and bias.dtype != input.dtype:
+        bias = bias.to(dtype=input.dtype)
+    in_f = input.shape[-1]
+    rows = input.numel() // in_f
+    flat = input.reshape(rows, in_f)
+    key = (int(weight.shape[0]), int(weight.shape[1]), str(weight.dtype))
+
+    def apply(chunk):
+        if chunk == "cpu":
+            b = None if bias is None else bias.detach().to("cpu")
+            out = _orig_linear(flat.detach().to("cpu"), weight.detach().to("cpu"), b)
+            return out.to(device=input.device, dtype=out.dtype).reshape(*input.shape[:-1], weight.shape[0])
+        step = rows if chunk >= rows else chunk
+        parts = [_orig_linear(flat[i:i + step], weight, bias) for i in range(0, rows, step)]
+        out = parts[0] if len(parts) == 1 else torch.cat(parts, 0)
+        return out.reshape(*input.shape[:-1], weight.shape[0])
+
+    mode = _xpu_linear_chunk.get(key)
+    if mode is not None:
+        return apply(mode)
+    for chunk in (128, 64, 32, 16, 8, 1, "cpu"):
+        if chunk != "cpu" and chunk > rows:
+            continue
+        try:
+            out = apply(chunk)
+        except RuntimeError:
+            continue
+        _xpu_linear_chunk[key] = chunk
+        return out
+    raise RuntimeError("could not create a primitive")
+
+torch.nn.functional.linear = _xpu_chunked_linear
+
