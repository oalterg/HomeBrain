+def _xpu_mm(a, b):
+    try:
+        return torch.matmul(a, b)
+    except RuntimeError:
+        return torch.matmul(a.detach().to("cpu"), b.detach().to("cpu")).to(device=a.device, dtype=a.dtype)
+
+def _xpu_attention(q, k, v, attn_mask=None, is_causal=False, scale=None):
+    """Per-head attention. Arc oneDNN cannot build an SDPA primitive; the matmuls work."""
+    squeeze = q.dim() == 3
+    if squeeze:
+        q, k, v = q.unsqueeze(0), k.unsqueeze(0), v.unsqueeze(0)
+    if k.shape[-3] != q.shape[-3]:
+        n_rep = q.shape[-3] // k.shape[-3]
+        k = k.repeat_interleave(n_rep, dim=-3)
+        v = v.repeat_interleave(n_rep, dim=-3)
+    if scale is None:
+        scale = q.shape[-1] ** -0.5
+    bsz, heads, seq, dim = q.shape
+    sk = k.shape[-2]
+    out = torch.empty(bsz, heads, seq, dim, device=q.device, dtype=q.dtype)
+    causal = torch.ones(seq, sk, device=q.device, dtype=torch.bool).triu(1) if is_causal else None
+    for b in range(bsz):
+        for h in range(heads):
+            scores = _xpu_mm(q[b, h], k[b, h].transpose(0, 1)).float().mul_(scale)
+            if causal is not None:
+                scores.masked_fill_(causal, float("-inf"))
+            if attn_mask is not None:
+                m = attn_mask
+                if m.dim() == 4:
+                    m = m[min(b, m.shape[0] - 1), min(h, m.shape[1] - 1)]
+                elif m.dim() == 3:
+                    m = m[min(b, m.shape[0] - 1)]
+                if m.dtype == torch.bool:
+                    scores.masked_fill_(~m, float("-inf"))
+                else:
+                    scores = scores + m.float()
+            probs = torch.softmax(scores, dim=-1).to(dtype=q.dtype)
+            out[b, h] = _xpu_mm(probs, v[b, h])
+    return out[0] if squeeze else out
