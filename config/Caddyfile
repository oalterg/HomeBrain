# HomeBrain LAN HTTPS edge. The only process that faces the LAN.
#
# Owner-facing URLs are names on 443, no ports:
#   homebrain.local        dashboard (host gunicorn via Docker host-gateway)
#   nc.homebrain.local     Nextcloud
#   vault.homebrain.local  Vaultwarden
#   ha.homebrain.local     Home Assistant
#
# Caddy mints one internal CA covering all four. Download it from the
# dashboard as this box's certificate. Persistent PKI lives in caddy_data.
#
# A raw IP on 443 is the dashboard (one service). Phones that cannot
# resolve .local should use the name, not https://192.168.x.x.
#
# Loopback/health/MCP keep talking to 127.0.0.1 on unpublished ports.

{
	auto_https disable_redirects
	admin off
	default_sni homebrain.local
	log {
		output stdout
		format console
		level WARN
	}
}

http:// {
	redir https://{host}{uri} permanent
}

# Dashboard + IP catch-all. {$VAULT_LAN_IP} is a SAN so a browser that
# reached the box by raw IP still completes TLS; the page itself is the
# dashboard, not a fourth app.
homebrain.local, 127.0.0.1, {$VAULT_LAN_IP:127.0.0.2} {
	tls internal

	@health path /healthz
	respond @health 200

	reverse_proxy host.docker.internal:8000
}

nc.homebrain.local {
	tls internal
	reverse_proxy nextcloud:80 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
	}
}

vault.homebrain.local {
	tls internal
	reverse_proxy vaultwarden:80 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
	}
}

ha.homebrain.local {
	tls internal
	reverse_proxy homeassistant:8123 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
	}
}
