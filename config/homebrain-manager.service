[Unit]
Description=HomeBrain Manager
After=network.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
User=root
WorkingDirectory=/opt/homebrain/src
# Include /sbin and /usr/sbin so the manager's subprocess calls find
# admin tools that live there (blkid, mount, mkfs.*, parted, ip, etc.).
# Debian/Ubuntu root historically gets this PATH; systemd starts services
# with a stripped one unless we set it explicitly.
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/sbin:/usr/bin:/bin"
# Refresh the platform record at boot. app.py reads it instead of re-probing the
# hardware itself, and boot is the only moment it can change (a driver that
# stopped loading after a kernel update). Non-fatal: app.py falls back to asking
# common.sh directly if the file is missing.
ExecStartPre=-/bin/bash -c 'source /opt/homebrain/scripts/common.sh >/dev/null 2>&1 && emit_platform_json'
# gevent worker class is required for the /openclaw WebSocket reverse-proxy
# (flask-sock + simple-websocket). gunicorn auto-applies gevent monkey-patch
# at startup so existing subprocess/threading code keeps working — long
# blocking calls just yield to other greenlets instead of stalling the worker.
# :8000 is not an owner-facing URL. Caddy (LAN 443) and Pangolin (newt on
# the compose network) reach this via the Docker bridge gateway. Bound on
# all interfaces so host-gateway packets arrive. Install an INPUT guard
# before listening, independent of whether UFW is installed or enabled.
ExecStartPre=/bin/bash /opt/homebrain/scripts/manager_firewall.sh
ExecStart=/opt/homebrain/venv/bin/gunicorn --worker-class gevent --workers 3 --bind 0.0.0.0:8000 --timeout 30 app:app
Restart=always
RestartSec=10
TimeoutStartSec=60
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target