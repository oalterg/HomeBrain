+++ b/ggml/src/ggml-sycl/moe-weighted-reduction.hpp
@@ -0,0 +1,22 @@
+#ifndef GGML_SYCL_MOE_WEIGHTED_REDUCTION_HPP
+#define GGML_SYCL_MOE_WEIGHTED_REDUCTION_HPP
+
+#include "common.hpp"
+
+// the weighted sum over the used experts of a MoE layer, a port of ggml-cuda's (#25952):
+//   (experts * expert_scale) * router_weight or experts * router_weight, then one view per expert and a chain of adds
+struct ggml_sycl_moe_weighted_reduction_match {
+    const ggml_tensor * experts      = nullptr;
+    const ggml_tensor * expert_scale = nullptr;
+    const ggml_tensor * weights      = nullptr;
+    ggml_tensor *       dst          = nullptr;
+    int                 node_count   = 0;
+};
+
+bool ggml_sycl_match_moe_weighted_reduction(const ggml_cgraph * cgraph, int node_idx,
+                                            ggml_sycl_moe_weighted_reduction_match & match);
+
+// run the fused reduction if the chain starts at node i, returns the number of following nodes consumed (0: no fusion)
+int ggml_sycl_try_fuse_moe_weighted_reduction(ggml_backend_sycl_context & ctx, ggml_cgraph * cgraph, int i);
+
+#endif  // GGML_SYCL_MOE_WEIGHTED_REDUCTION_HPP
