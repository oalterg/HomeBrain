diff --git a/ggml/src/ggml-sycl/mmid-scale.cpp b/ggml/src/ggml-sycl/mmid-scale.cpp
new file mode 100644
index 000000000..fd10b2bba
--- /dev/null
+++ b/ggml/src/ggml-sycl/mmid-scale.cpp
@@ -0,0 +1,67 @@
+#include "mmid-scale.hpp"
+
+#include "ggml-impl.h"
+
+const ggml_tensor * ggml_sycl_match_mul_mat_id_scale(const ggml_cgraph * cgraph, int node_idx) {
+    if (node_idx + 4 >= cgraph->n_nodes) {
+        return nullptr;
+    }
+    const ggml_tensor * mm      = cgraph->nodes[node_idx];
+    const ggml_tensor * reshape = cgraph->nodes[node_idx + 1];
+    const ggml_tensor * repeat  = cgraph->nodes[node_idx + 2];
+    const ggml_tensor * getrows = cgraph->nodes[node_idx + 3];
+    const ggml_tensor * mul     = cgraph->nodes[node_idx + 4];
+    if (mm->op != GGML_OP_MUL_MAT_ID || reshape->op != GGML_OP_RESHAPE || repeat->op != GGML_OP_REPEAT ||
+        getrows->op != GGML_OP_GET_ROWS || mul->op != GGML_OP_MUL) {
+        return nullptr;
+    }
+    // the chain of ggml_cuda_get_mul_mat_id_scale
+    if (repeat->src[0] != reshape || getrows->src[0] != repeat || getrows->src[1] != mm->src[2]) {
+        return nullptr;
+    }
+    if (!((mul->src[0] == mm && mul->src[1] == getrows) || (mul->src[0] == getrows && mul->src[1] == mm))) {
+        return nullptr;
+    }
+    const ggml_tensor * scale = reshape->src[0];
+    const ggml_tensor * ids   = mm->src[2];
+    if (scale == nullptr || scale->type != GGML_TYPE_F32 || !ggml_is_contiguous(scale) ||
+        ggml_nelements(scale) != mm->src[0]->ne[2] || mm->type != GGML_TYPE_F32 || mul->type != GGML_TYPE_F32 ||
+        !ggml_is_contiguous(mm) || !ggml_is_contiguous(mul) || !ggml_are_same_shape(mul, mm) || mm->ne[3] != 1 ||
+        ids->type != GGML_TYPE_I32 || ids->ne[0] != mm->ne[1] || ids->ne[1] != mm->ne[2]) {
+        return nullptr;
+    }
+    const ggml_op ops[5]  = { GGML_OP_MUL_MAT_ID, GGML_OP_RESHAPE, GGML_OP_REPEAT, GGML_OP_GET_ROWS, GGML_OP_MUL };
+    const int     out_idx = node_idx + 4;
+    if (!ggml_can_fuse_subgraph(cgraph, node_idx, 5, ops, &out_idx, 1)) {
+        return nullptr;
+    }
+    return scale;
+}
+
+void ggml_sycl_op_mul_mat_id_scale(ggml_backend_sycl_context & ctx, const ggml_tensor * mm, const ggml_tensor * scale,
+                                   ggml_tensor * dst) {
+    const ggml_tensor * ids      = mm->src[2];
+    const int64_t       ne0      = mm->ne[0];
+    const int64_t       ne1      = mm->ne[1];
+    const int64_t       n        = ggml_nelements(mm);
+    const uint32_t      n_expert = (uint32_t) ggml_nelements(scale);
+    const size_t        ib0      = ids->nb[0];
+    const size_t        ib1      = ids->nb[1];
+    const float *       x        = (const float *) mm->data;
+    const float *       s        = (const float *) scale->data;
+    const char *        id       = (const char *) ids->data;
+    float *             d        = (float *) dst->data;
+
+    GGML_SYCL_DEBUG("[SYCL] fused mul_mat_id weight scale\n");
+    constexpr int WG = 256;
+    ctx.stream()->parallel_for(sycl::nd_range<1>(sycl::range<1>(((n + WG - 1) / WG) * WG), sycl::range<1>(WG)),
+                               [=](sycl::nd_item<1> it) {
+                                   const int64_t g = it.get_global_id(0);
+                                   if (g >= n) {
+                                       return;
+                                   }
+                                   const int64_t r = g / ne0;  // (slot, token)
+                                   const int32_t k = *(const int32_t *) (id + (r % ne1) * ib0 + (r / ne1) * ib1);
+                                   d[g]            = x[g] * ((uint32_t) k < n_expert ? s[k] : 0.0f);
+                               });
+}
