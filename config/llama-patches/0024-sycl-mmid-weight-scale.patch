new file mode 100644
index 000000000..d9e1f3bec
--- /dev/null
+++ b/ggml/src/ggml-sycl/mmid-scale.hpp
@@ -0,0 +1,14 @@
+#ifndef GGML_SYCL_MMID_SCALE_HPP
+#define GGML_SYCL_MMID_SCALE_HPP
+
+#include "common.hpp"
+
+// MUL_MAT_ID with one weight scale per expert (NVFP4 checkpoints): RESHAPE, REPEAT and GET_ROWS (by the ids) of the
+// scales, then the MUL. Returns the scales when the 5 nodes at node_idx have that form and may be fused, else null.
+const ggml_tensor * ggml_sycl_match_mul_mat_id_scale(const ggml_cgraph * cgraph, int node_idx);
+
+// dst = mm * scale[ids]: the MUL of the chain, reading the scales by the ids directly
+void ggml_sycl_op_mul_mat_id_scale(ggml_backend_sycl_context & ctx, const ggml_tensor * mm, const ggml_tensor * scale,
+                                   ggml_tensor * dst);
+
+#endif  // GGML_SYCL_MMID_SCALE_HPP
