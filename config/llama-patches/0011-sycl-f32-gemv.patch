 // per-token attention over earlier block outputs. The generic path issues one GEMM per batch, which
-// for thousands of batches of a few thousand MACs each is all launch overhead.
+// for thousands of batches of a few thousand MACs each is all launch overhead. A single small product
+// with few columns (a decode-time f32 GEMV, e.g. Inkling 2's loop-control and router weights) takes
+// the same kernel: there the generic path's host cost exceeds the product's.
 static bool ggml_sycl_mul_mat_small_batched_f32(ggml_backend_sycl_context & ctx, const ggml_tensor * src0,
                                                 const ggml_tensor * src1, ggml_tensor * dst) {
     if (src0->type != GGML_TYPE_F32 || src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) {
@@ -5202,7 +5204,11 @@ static bool ggml_sycl_mul_mat_small_batched_f32(ggml_backend_sycl_context & ctx,
     }
     const int64_t K = src0->ne[0], M = src0->ne[1], N = src1->ne[1];
     const int64_t B2 = src1->ne[2], B3 = src1->ne[3];
-    if (src0->ne[2] * src0->ne[3] == 1 || B2 * B3 < 32 || M * N * K > 65536) {
+    const bool batched = src0->ne[2] * src0->ne[3] > 1 && B2 * B3 >= 32 && M * N * K <= 65536;
+    // a Hadamard-hinted src0 keeps its fast transform below
+    const bool gemv    = src0->ne[2] * src0->ne[3] == 1 && B2 * B3 == 1 && N <= 32 && M * N * K <= (1 << 20) &&
+                         ggml_get_op_params_i32(dst, 1) != GGML_HINT_SRC0_IS_HADAMARD;
+    if (!batched && !gemv) {
         return false;
     }
     if (B2 % src0->ne[2] != 0 || B3 % src0->ne[3] != 0) {
@@ -5218,6 +5224,31 @@ static bool ggml_sycl_mul_mat_small_batched_f32(ggml_backend_sycl_context & ctx,
     const int64_t n_out = M * N * B2 * B3;
     queue_ptr stream = ctx.stream();
 
+    if (gemv && K >= 64 && K % 4 == 0 && a0 == sizeof(float) && b0 == sizeof(float) && a1 % 16 == 0 &&
+            b1 % 16 == 0 && (uintptr_t) a % 16 == 0 && (uintptr_t) b % 16 == 0) {
+        // one work-group per output, float4 loads split over K (few rows of a long K would leave
+        // a sub-group per output latency-bound), then a group reduction
+        const int L = K >= 1024 ? 256 : K >= 256 ? 64 : WARP_SIZE;
+        stream->parallel_for(sycl::nd_range<1>(sycl::range<1>(n_out * L), sycl::range<1>(L)),
+            [=](sycl::nd_item<1> it) [[sycl::reqd_sub_group_size(WARP_SIZE)]] {
+                const int64_t i = it.get_group(0) % M;
+                const int64_t j = it.get_group(0) / M;
+                const sycl::float4 * pa = (const sycl::float4 *) (a + i*a1);
+                const sycl::float4 * pb = (const sycl::float4 *) (b + j*b1);
+                float sum = 0.0f;
+                for (int64_t k = it.get_local_id(0); k < K/4; k += L) {
+                    const sycl::float4 x = pa[k];
+                    const sycl::float4 y = pb[k];
+                    sum += x.x()*y.x() + x.y()*y.y() + x.z()*y.z() + x.w()*y.w();
+                }
+                sum = sycl::reduce_over_group(it.get_group(), sum, sycl::plus<float>());
+                if (it.get_local_id(0) == 0) {
+                    *(float *) (d + i*d0 + j*d1) = sum;
+                }
+            });
+        return true;
+    }
