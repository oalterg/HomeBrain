+#ifndef GGML_SYCL_INKLING2_HPP
+#define GGML_SYCL_INKLING2_HPP
+
+#include "common.hpp"
+
+// fused op chains of the Inkling 2 graph, a port of ggml-cuda/inkling2.cu and the matchers of ggml-cuda/fusion.cu:
+// the situ activation, the L2 clip, the causal short conv with its state store, the depth mix and the loop controller
+
+// largest conv width and stack depth the fused kernels handle
+#define GGML_SYCL_SHORT_CONV_MAX_K   8
+#define GGML_SYCL_DEPTH_MIX_MAX_ROWS 16
+
+// the most tokens the fused loop controller handles, larger batches use the matrix multiplications
+#define GGML_SYCL_LOOP_CTRL_MAX_TOKENS 8
+
+// try to fuse the chain that starts at node i, returns the number of following nodes consumed (0: no fusion)
+int ggml_sycl_try_fuse_inkling2(ggml_backend_sycl_context & ctx, ggml_cgraph * cgraph, int i);
+
+#endif  // GGML_SYCL_INKLING2_HPP
