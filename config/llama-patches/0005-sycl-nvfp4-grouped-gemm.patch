+++ b/ggml/src/ggml-sycl/fused-gemm.hpp
@@ -53,6 +53,10 @@ constexpr bool ggml_sycl_fused_dequant_gemm_type_ok(ggml_type src0_type, int64_t
     if (src0_type == GGML_TYPE_IQ4_NL || src0_type == GGML_TYPE_Q8_0) {
         return K % 32 == 0;
     }
+    // nvfp4 stores 64 values per block, walked in two steps of 32
+    if (src0_type == GGML_TYPE_NVFP4) {
