diff --git a/ggml/src/ggml-sycl/quants.hpp b/ggml/src/ggml-sycl/quants.hpp
index 79b5c8de5..bb030df2f 100644
--- a/ggml/src/ggml-sycl/quants.hpp
+++ b/ggml/src/ggml-sycl/quants.hpp
@@ -332,6 +332,27 @@ template <> struct block_q_t<GGML_TYPE_MXFP4> {
     static constexpr int block_to_q8_1_ratio() { return traits::qk / QK8_1; }  // 1
 };
 
+template <> struct block_q_t<GGML_TYPE_NVFP4> {
+    struct traits {
+        static constexpr uint32_t qk       = QK_NVFP4;  // 64
+        static constexpr uint32_t qi       = QI_NVFP4;  // 8
+        static constexpr uint32_t qr       = QR_NVFP4;  // 2
+        static constexpr uint32_t vdr_mmvq = 4;
+    };
+
+    // NVFP4 reorder layout: [qs0|qs1|...|qsN][d0|d1|...|dN], 32 qs bytes and 4 UE4M3 scales per block.
+    // The 36-byte AoS block leaves the qs of odd blocks off a 16-byte boundary; split out, every block's qs is aligned.
+    static constexpr std::pair<int, int> get_block_offset(const int block_index, const int /* nblocks */) {
+        return { block_index * (QK_NVFP4 / 2), 0 };
+    }
+
+    static constexpr std::pair<int, int> get_d_offset(int nrows, int ncols, const int block_index) {
+        return { (ncols / 2 * nrows) + block_index * (QK_NVFP4 / QK_NVFP4_SUB), 0 };
+    }
+
+    static constexpr int block_to_q8_1_ratio() { return traits::qk / QK8_1; }  // 2
+};
+
 }  // namespace ggml_sycl_reordered
 
 #endif  // GGML_SYCL_QUANTS_HPP
diff --git a/ggml/src/ggml-sycl/vecdotq.hpp b/ggml/src/ggml-sycl/vecdotq.hpp
index 2da7e25cc..43d2b6372 100644
--- a/ggml/src/ggml-sycl/vecdotq.hpp
+++ b/ggml/src/ggml-sycl/vecdotq.hpp
@@ -861,6 +861,50 @@ template <> struct reorder_vec_dot_q_sycl<GGML_TYPE_MXFP4> {
         return d * sumi;
     }
 };
+
+template <> struct reorder_vec_dot_q_sycl<GGML_TYPE_NVFP4> {
+    static constexpr ggml_type gtype = GGML_TYPE_NVFP4;
+
+    using nvfp4_block  = ggml_sycl_reordered::block_q_t<GGML_TYPE_NVFP4>;
+    using nvfp4_traits = typename nvfp4_block::traits;
+
+    __dpct_inline__ float operator()(const void * __restrict__ vbq, const std::pair<int, int> ibx_offset,
+                                     const std::pair<int, int> d_offset, const int8_t * q8_1_quant_ptr,
+                                     const sycl::half2 * q8_1_ds, const int & iqs) {
+        static_assert(nvfp4_traits::vdr_mmvq == 4, "vector load assumes vdr_mmvq == 4");
+        const uint8_t * base = static_cast<const uint8_t *>(vbq);
+
+        // iqs is 0 or 4: the lane's 16 qs bytes, one aligned load, are sub-blocks iqs/2 and iqs/2 + 1, the 32 values
+        // of q8_1 block iqs/4 of this block. In a sub-block, the low nibbles are values 0..7 and the high ones 8..15.
+        const sycl::int4 q4 = *reinterpret_cast<const sycl::int4 *>(base + ibx_offset.first + sizeof(int) * iqs);
+        const uint8_t *  d  = base + d_offset.first + iqs / 2;
+
+        const int8_t *   q8 = q8_1_quant_ptr + (iqs / 4) * QK8_1;
+        const sycl::int4 u0 = *reinterpret_cast<const sycl::int4 *>(q8);
+        const sycl::int4 u1 = *reinterpret_cast<const sycl::int4 *>(q8 + QK8_1 / 2);
+        const float      ds = static_cast<float>(q8_1_ds[iqs / 4][0]);
+
+        const sycl::int2 v0 = get_int_from_mxfp4(q4.x());
+        const sycl::int2 v1 = get_int_from_mxfp4(q4.y());
+        const sycl::int2 v2 = get_int_from_mxfp4(q4.z());
+        const sycl::int2 v3 = get_int_from_mxfp4(q4.w());
+
+        int sumi0 = ggml_sycl_dp4a(v0.x(), u0.x(), 0);
+        sumi0     = ggml_sycl_dp4a(v0.y(), u0.z(), sumi0);
+        sumi0     = ggml_sycl_dp4a(v1.x(), u0.y(), sumi0);
+        sumi0     = ggml_sycl_dp4a(v1.y(), u0.w(), sumi0);
+
+        int sumi1 = ggml_sycl_dp4a(v2.x(), u1.x(), 0);
+        sumi1     = ggml_sycl_dp4a(v2.y(), u1.z(), sumi1);
+        sumi1     = ggml_sycl_dp4a(v3.x(), u1.y(), sumi1);
+        sumi1     = ggml_sycl_dp4a(v3.y(), u1.w(), sumi1);
+
+        // the order of vec_dot_nvfp4_q8_1
+        float sum = (ggml_sycl_ue4m3_to_fp32(d[0]) * ds) * float(sumi0);
+        sum += (ggml_sycl_ue4m3_to_fp32(d[1]) * ds) * float(sumi1);
+        return sum;
+    }
+};
 #define VDR_Q4_0_Q8_1_MMVQ 2
 #define VDR_Q4_0_Q8_1_MMQ  4
 
