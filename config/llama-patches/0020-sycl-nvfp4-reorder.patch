 }
 
+// Reordered NVFP4 ([qs...][d...], see ggml_sycl_reordered::block_q_t<NVFP4>): four qs bytes of one sub-block per item,
+// values j..j+3 and 8+j..8+j+3, in two vec<dst_t, 4> stores. The lookups and scales of dequantize_block_nvfp4.
+template <typename dst_t>
+static void dequantize_block_nvfp4_reorder(const void * __restrict__ vx, dst_t * __restrict__ yy, const int64_t k,
+                                           const sycl::id<1> idx) {
+    const int64_t i   = (int64_t) idx[0];
+    const int64_t ib  = i / 8;
+    const int     sub = (int) (i % 8) / 2;
+    const int     j0  = 4 * (int) (i % 2);
+
+    const uint8_t * qs = (const uint8_t *) vx + ib * (QK_NVFP4 / 2) + sub * (QK_NVFP4_SUB / 2) + j0;
+    const float     d  = ggml_sycl_ue4m3_to_fp32(((const uint8_t *) vx)[k / 2 + ib * (QK_NVFP4 / QK_NVFP4_SUB) + sub]);
+    dst_t *         y  = yy + ib * QK_NVFP4 + sub * QK_NVFP4_SUB + j0;
+
+    sycl::vec<dst_t, 4> lo, hi;
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+        lo[j] = ggml_sycl_cast<dst_t>(d * kvalues_mxfp4[qs[j] & 0x0F]);
+        hi[j] = ggml_sycl_cast<dst_t>(d * kvalues_mxfp4[qs[j] >> 4]);
+    }
+    *reinterpret_cast<sycl::vec<dst_t, 4> *>(y)                    = lo;
+    *reinterpret_cast<sycl::vec<dst_t, 4> *>(y + QK_NVFP4_SUB / 2) = hi;
+}
+
 
 #endif // GGML_SYCL_DEQUANTIZE_HPP
