{
  "browser": {
    "enabled": true,
    "headless": true,
    "noSandbox": true
  },
  "models": {
    "mode": "merge",
    "providers": {
      "llamacpp": {
        "baseUrl": "http://127.0.0.1:8001/v1",
        "apiKey": "1234",
        "api": "openai-completions",
        "timeoutSeconds": 1800,
        "models": [
          {
            "id": "Muse-Glimmer-30B-UD-Q4_K_XL",
            "name": "Muse-Glimmer-30B-UD-Q4_K_XL",
            "reasoning": true,
            "compat": {
              "thinkingFormat": "deepseek"
            },
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 131072,
            "maxTokens": 16384
          }
        ]
      },
      "openai": {
        "apiKey": "dummy-local-whisper",
        "baseUrl": "http://127.0.0.1:8002/v1",
        "models": []
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "llamacpp/Muse-Glimmer-30B-UD-Q4_K_XL"
      },
      "models": {
        "llamacpp/Muse-Glimmer-30B-UD-Q4_K_XL": {}
      },
      "workspace": "/home/homebrain/.openclaw/workspace",
      "thinkingDefault": "xhigh",
      "compaction": {
        "mode": "default",
        "reserveTokensFloor": 35000,
        "timeoutSeconds": 1200,
        "notifyUser": true
      },
      "heartbeat": {
        "every": "1h",
        "timeoutSeconds": 3000
      }
    },
    "list": [
      {
        "id": "main",
        "tools": {
          "profile": "full",
          "alsoAllow": [
            "browser"
          ]
        }
      }
    ]
  },
  "tools": {
    "exec": {
      "mode": "full"
    },
    "elevated": {
      "enabled": true
    },
    "media": {
      "audio": {
        "enabled": true,
        "scope": {
          "default": "allow"
        },
        "models": [
          {
            "capabilities": [
              "audio"
            ],
            "baseUrl": "http://127.0.0.1:8002/v1",
            "timeoutSeconds": 30
          }
        ]
      }
    },
    "deny": [
      "cron"
    ]
  },
  "approvals": {
    "exec": {
      "enabled": false
    },
    "plugin": {
      "enabled": true,
      "mode": "session"
    }
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "loopback",
    "controlUi": {
      "basePath": "/openclaw",
      "allowedOrigins": []
    },
    "auth": {
      "mode": "token",
      "token": ""
    }
  },
  "plugins": {
    "entries": {
      "browser": {
        "enabled": true
      }
    }
  }
}
